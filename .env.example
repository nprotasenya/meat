# Який провайдер використовувати: whapi | cloud_api | twilio
WHATSAPP_PROVIDER=whapi

# Куди прийде сповіщення про нове замовлення (номер менеджера, твій номер)
MANAGER_WHATSAPP_NUMBER=380671234567

# --- Whapi.Cloud (рекомендовано для кейсу "1 замовлення = 1 повідомлення") ---
# Реєстрація: https://whapi.cloud -> New channel -> Authorize (сканиш QR) -> скопіювати API token
WHAPI_TOKEN=
WHAPI_URL=https://gate.whapi.cloud

# --- WhatsApp Cloud API (Meta for Developers) ---
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_API_VERSION=v20.0
# Заповнюй, лише якщо 24-годинне вікно діалогу закрите і потрібен затверджений template
WA_CLOUD_TEMPLATE_NAME=
WA_CLOUD_TEMPLATE_LANG=uk

# --- Twilio (альтернативний провайдер) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Дозволені origin для CORS (адреса фронтенду на Vercel), через кому. * = будь-який (тільки для тесту)
ALLOWED_ORIGINS=*
